# Copie para .env e preencha. O .env NUNCA vai para o Git nem para o navegador.
# Sem chave, o app roda em modo simulado (logos de teste).

# --- Cota grátis do servidor (Pollinations) -----------------------------------
# Crie a Secret key (sk_...) grátis em https://enter.pollinations.ai (login com GitHub).
POLLINATIONS_API_KEY=
# Recarga da cota: hourly (Spore/Seed) ou daily (Flower/Nectar)
# POLLEN_REFILL=hourly
# Qualidade do GPT Image 2: high (premium, padrão), medium ou low (rende mais pedidos grátis)
# IMAGE_QUALITY=high
# Teto de gasto por dia em pollen (só faz sentido se comprar créditos). 0 = sem teto
# DAILY_BUDGET=0
# Se a imagem falhar, o GPT-5.6 Sol desenha o SVG à mão (qualidade inferior)
# PLAN_B_SVG=false

# Modelos do servidor (padrões; só mude se quiser outro)
# TEXT_MODEL=openai/gpt-5.6-sol
# TEXT_FALLBACK_MODELS=openai/gpt-5.5
# IMAGE_MODEL=openai/gpt-image-2
# IMAGE_FALLBACK_MODELS=openai/gpt-image-1.5
# REASONING_EFFORT=medium

# --- Cota grátis do visitante (Puter.js) — DESLIGADA por padrão ---------------
# puter = quando a cota do servidor acaba, o navegador do visitante gera com a cota grátis dele
#         (mostra a tela de acesso do Puter: não indicado para uso comercial)
# CLIENT_FALLBACK=off
# PUTER_TEXT_MODEL=openai/gpt-5.6-sol
# PUTER_IMAGE_MODEL=openai/gpt-image-2
# Com a fila do servidor maior que isso, novos pedidos vão direto para a cota do visitante
# CLIENT_QUEUE_THRESHOLD=2

# --- Testes -------------------------------------------------------------------
# PROVIDER=mock    # logos simuladas, sem internet
# MOCK_QUOTA=2     # simula a cota do servidor acabando depois de 2 imagens

# --- Servidor -----------------------------------------------------------------
PORT=3000
# HOST=0.0.0.0
# Atrás do nginx/Plesk: 1 (padrão em produção) para ler o IP real do visitante
# TRUST_PROXY=1
# Sites autorizados a embutir o app num <iframe> (separe por vírgula)
# FRAME_ANCESTORS=https://seusite.com.br

# --- Limites (operação 24/7) --------------------------------------------------
# SAMPLES=5
# MAX_CONCURRENT_JOBS=2
# MAX_QUEUED_JOBS=20
# IMAGE_CONCURRENCY=5
# IMAGE_RPM=6
# RATE_LIMIT_MAX=6
# RATE_LIMIT_WINDOW_MS=3600000
# UPLOAD_MAX_FILES=3
# UPLOAD_MAX_MB=8
# JOB_TIMEOUT_MS=480000
# IMAGE_TIMEOUT_MS=240000
# MAX_RETRIES=2
