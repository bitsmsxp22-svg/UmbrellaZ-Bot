# Copie para .env e preencha. O .env NUNCA vai para o Git nem para o navegador.

# --- Provedor de IA -----------------------------------------------------------
# pollinations = gen.pollinations.ai (GPT-5.6 Sol + GPT Image 2)
# openai       = API oficial da OpenAI
# mock         = simulado, sem internet (só para testar a interface)
PROVIDER=pollinations
POLLINATIONS_API_KEY=
# OPENAI_API_KEY=

# Modelos (padrões do preset escolhido; só mude se quiser outro)
# TEXT_MODEL=openai/gpt-5.6-sol
# TEXT_FALLBACK_MODELS=openai/gpt-5.5
# IMAGE_MODEL=openai/gpt-image-2
# IMAGE_FALLBACK_MODELS=openai/gpt-image-1.5
# REASONING_EFFORT=low
# IMAGE_QUALITY=high

# --- Servidor -----------------------------------------------------------------
PORT=3000
# HOST=0.0.0.0
# Atrás do nginx/Plesk: 1 (padrão em produção) para ler o IP real do visitante
# TRUST_PROXY=1
# Sites autorizados a embutir o app num <iframe> (separe por vírgula)
# FRAME_ANCESTORS=https://seusite.com.br

# --- Limites (operação 24/7) --------------------------------------------------
# SAMPLES=5
# MAX_CONCURRENT_JOBS=2
# MAX_QUEUED_JOBS=20
# IMAGE_CONCURRENCY=5
# RATE_LIMIT_MAX=6
# RATE_LIMIT_WINDOW_MS=3600000
# UPLOAD_MAX_FILES=3
# UPLOAD_MAX_MB=8
# JOB_TIMEOUT_MS=480000
# IMAGE_TIMEOUT_MS=240000
# MAX_RETRIES=2
